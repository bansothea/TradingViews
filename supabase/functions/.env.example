# ---------------------------------------------------------------------------
# Supabase Edge Function secrets (Deno runtime).
#
# Local:  copy to supabase/functions/.env -- `supabase functions serve` loads it
# Hosted: supabase secrets set --env-file supabase/functions/.env
#
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected by
# the platform automatically and must NOT be set here.
# ---------------------------------------------------------------------------

GEMINI_API_KEY=

# Comma-separated browser origins permitted to call these functions.
ALLOWED_ORIGINS=http://localhost:3000

# Only needed once you add authenticated Binance account features.
# Public market data (klines) requires no credentials.
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
